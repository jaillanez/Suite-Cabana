# Base de datos
POSTGRES_USER=suite
POSTGRES_PASSWORD=suite
POSTGRES_DB=suite_cabana
DATABASE_URL=postgresql+psycopg://suite:suite@localhost:5432/suite_cabana

# Backend
SECRET_KEY=generala-con-python3--c-import-secrets-print-secrets-token_urlsafe-48
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
IVA_COMISION=0.21

# Dirección pública del backend: entra en las URLs de calendario que el prestador
# pega en Booking o Airbnb, así que no puede ser relativa.
URL_PUBLICA_API=http://localhost:8000

# Ingreso con Google (ver README). Sin esto, el botón no aparece y el endpoint
# responde 501. El client id no es secreto: va también en el frontend.
GOOGLE_CLIENT_ID=

# Notificaciones (docs/01 §5 R9)
# Sin SMTP y en entorno local, los correos se escriben en el log en vez de
# enviarse. El proveedor de WhatsApp todavía no está decidido (docs/01 §9).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_DESDE=
SMTP_TLS=true
WHATSAPP_PROVEEDOR=
WHATSAPP_TOKEN=

# Versión vigente de los términos (docs/01 §5 R11)
VERSION_TERMINOS=2026-09

# Pasarelas de pago (docs/00 §8)
# El producto no se ata a una billetera. Cada una tiene sus credenciales; vacías
# significa que existe pero no está disponible. "simulada" solo anda en local.
PASARELA_PREDETERMINADA=simulada
URL_PUBLICA_WEB=http://localhost:3000

# Mercado Pago (modo marketplace) — adaptador implementado
MP_ACCESS_TOKEN=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=

# Previstas: el adaptador se escribe cuando tengamos su documentación técnica
MODO_CLIENT_ID=
MODO_CLIENT_SECRET=
MODO_WEBHOOK_SECRET=
UALA_API_KEY=
UALA_WEBHOOK_SECRET=
CUENTA_DNI_API_KEY=
CUENTA_DNI_WEBHOOK_SECRET=
NARANJA_X_API_KEY=
NARANJA_X_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Buzón de reservas por correo (Despegar y cualquier portal que mande mails) ---
# El anfitrión reenvía los mails de confirmación a una dirección propia y el
# proveedor de correo entrante nos los postea. Sin SECRETO el endpoint queda
# cerrado a propósito: un buzón abierto deja que cualquiera te ocupe el calendario.
# Proveedores que sirven: sendgrid (Inbound Parse), mailgun (Routes), postmark.
CORREO_ENTRANTE_PROVEEDOR=
CORREO_ENTRANTE_SECRETO=
CORREO_ENTRANTE_DOMINIO=
